# ---------- Telegram ----------
# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# Telegram ID владельцев через запятую. Узнать свой id: напишите боту /whoami
OWNER_TELEGRAM_IDS=123456789

# ---------- ApiPay ----------
# Ключ из кабинета: Настройки -> Подключение -> Создать новый ключ
APIPAY_API_KEY=
# Секрет подписи вебхука (Ещё -> Создать секретный ключ подписи).
# Если пуст, подпись не проверяется и статус счёта подтверждается через GET /invoices/{id}.
APIPAY_WEBHOOK_SECRET=
APIPAY_BASE_URL=https://api.apipay.kz/api/v1
# true — принимать события с is_sandbox=true (для приёмки в песочнице).
# В проде должно быть false: продовые события с is_sandbox=true отбрасываются.
APIPAY_SANDBOX=false

# ---------- Приложение ----------
# Путь к файлу SQLite. На Railway должен лежать на подключённом томе (volume),
# иначе база теряется при каждом редеплое.
DB_PATH=./data/botarba.db

TIMEZONE=Asia/Almaty
# Время вечерней сводки в формате HH:MM по TIMEZONE
SUMMARY_TIME=21:00

# HTTP-сервер для вебхука ApiPay
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Секретный путь вебхука: полный URL = https://<домен>/webhook/<APIPAY_WEBHOOK_PATH>
APIPAY_WEBHOOK_PATH=apipay

# Окно часовой сверки: сколько последних дней перезапрашивать у ApiPay.
# Продажи мимо ApiPay подтягиваются из истории Kaspi задним числом, поэтому > 1.
SYNC_WINDOW_DAYS=2

# Сколько минут действует кнопка «Отменить» под расходом
UNDO_WINDOW_MINUTES=10

# Каталог ежедневных бэкапов базы и срок их хранения
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# ---------- Google Таблицы (необязательно) ----------
# Адрес веб-приложения Apps Script из вашей таблицы.
# Инструкция: integrations/google_sheets/README.md
# Пусто = выгрузка отключена, бот работает как обычно.
SHEETS_WEBAPP_URL=
# Пароль, который бот присылает скрипту. Должен совпадать с TOKEN в скрипте.
SHEETS_TOKEN=
# Как часто синхронизировать таблицу на всякий случай, минут
SHEETS_SYNC_MINUTES=10
